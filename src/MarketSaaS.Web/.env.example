# Desarrollo: dejar VITE_API_BASE_URL vacío; Vite enruta /api y /hubs al backend.
# Por defecto el proxy usa http://localhost:5037 (perfil "http" en launchSettings).
# Si la API solo la levantás en HTTPS (7011), por ejemplo:
# VITE_API_PROXY_TARGET=https://localhost:7011
#
# Producción: host de la API SIN /api al final (si ponés .../api las rutas quedan /api/api/... → 404).
# VITE_API_BASE_URL=https://api.tudominio.com
